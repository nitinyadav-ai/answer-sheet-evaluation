# Copy this file to `.env` and fill in your secrets. Documents the full configuration surface.
# NOTE: keep comments on their OWN lines (the .env parsers also tolerate inline `# ...`, but separate
# lines are clearest).

# --- PostgreSQL (teacher-rejected answers are stored here; questions table is DB_TABLE) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_TABLE=ai_class10
REJECTED_ANSWERS_TABLE=rejected_answers

# ============================================================================
# LLM configuration -- OpenRouter / OpenAI-compatible Qwen3 (the only provider)
# ============================================================================
# OpenRouter: https://openrouter.ai/api/v1   |   local vLLM/SGLang: http://localhost:8000/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter API key (REQUIRED). Any non-empty value works for a local server.
LLM_API_KEY=your_openrouter_api_key
# Request response_format=json_object (auto-falls back if unsupported). 1=on, 0=off.
LLM_JSON_MODE=1

# --- Per-stage models (env-driven; A/B 30B <-> 32B by editing here, no code change) ---
# Instruct = fast/cheap (transcription, listing, classification). 32B A/B: qwen/qwen3-vl-32b-instruct
OCR_MODEL=qwen/qwen3-vl-30b-a3b-instruct
SEPARATOR_MODEL=qwen/qwen3-vl-30b-a3b-instruct
KEY_PARSER_MODEL=qwen/qwen3-vl-30b-a3b-instruct
DIAGRAM_FEATURES_MODEL=qwen/qwen3-vl-30b-a3b-instruct
# Cap on page-images one question may feed the diagram stages (detect_diagrams). Bounds a single
# over-mapped question (a bad OCR run can lump many pages under one id) so it can't explode the
# vision stages. Only trims pathological cases; normal 1-2 page diagrams are untouched.
MAX_DIAGRAM_PAGES_PER_Q=4
# Output cap for the diagram FEATURE pass -- the real bound on that stage's latency.
# A page that tipped the model into a repetition loop generated 16384 tokens (the provider's default,
# i.e. uncapped) in 625s, against 20-30s for a healthy read. Two runs lost their whole diagram stage to
# it. `timeout` CANNOT bound this: it is an httpx READ timeout (longest allowed silence between bytes)
# and a steady 26 tok/s stream never trips it -- measured, a timeout=200 call ran 625s. Only this cap
# ends a runaway. 1536 keeps a maxed response (~59s) inside the 90s per-call timeout; raising it past
# ~2300 lets a maxed call escape that timeout again. Dense pages may have their feature list truncated
# at the tail -- acceptable, since diagram grading also sees the page image itself.
DIAGRAM_FEATURES_MAX_TOKENS=1536

# Reasoning stages -> Thinking variant (these genuinely reason).
# reasoning_effort: low | medium | high  (blank = thinking off). max_tokens is raised so the
# chain-of-thought can't truncate the JSON verdict. Thinking is slower + pricier (~$1.56/M out vs
# ~$0.42/M, and many more tokens) -- A/B it against -instruct before a large batch.
EVAL_MODEL=qwen/qwen3-vl-30b-a3b-thinking
EVAL_REASONING_EFFORT=medium
EVAL_MAX_TOKENS=16000
DIAGRAM_EVAL_MODEL=qwen/qwen3-vl-30b-a3b-thinking
DIAGRAM_EVAL_REASONING_EFFORT=medium
# NOTE: the code default is 8192 and the live .env uses 12288 -- this 16000 is the permissive end of
# the range. The larger this is, the longer a single runaway generation can run (16000 tok / ~26 tok/s
# ~= 10 min for ONE pass, and eval_single makes two), which is what DIAGRAM_EVAL_STAGE_TIMEOUT bounds.
DIAGRAM_EVAL_MAX_TOKENS=16000
# Stage budget for diagram grading: how long the stage waits on its workers before abandoning the
# stragglers and KEEPING whatever finished. Default = 2 x DIAGRAM_LLM_TIMEOUT x (retries+1) + 30 = 390s.
# The 2x is because eval_single makes two SEQUENTIAL passes (grade, then audit). Must stay under the
# orchestrator's 420s watchdog for evaluate_diagrams.py -- above it the watchdog kills the stage first
# and every already-graded diagram is lost, which is the failure this budget exists to prevent.
DIAGRAM_EVAL_STAGE_TIMEOUT=390
# Diagram grading runs two passes: (1) text-only, student features vs the key; (2) a VISION audit that
# re-sends the page image. Pass 2 costs 34-110s against pass 1's 12-35s -- ~75% of the stage.
#   always  (default) audit every diagram, as before
#   cascade audit only a draft that is low-confidence or scored ZERO
#   never   never audit (pass 1 only)
# `cascade` DEFAULTS OFF because it was measured NOT to reduce wall-clock: max_workers is 10 and a sheet
# has a handful of diagram questions, so all pass-2 calls already run CONCURRENTLY -- dropping 4 to 2
# removes parallel work, not critical-path work (the wall is the single slowest call). It IS a real cost
# lever for batch runs, where concurrency rather than latency is scarce.
DIAGRAM_EVAL_AUDIT=always
# Confidence below which a draft is audited under `cascade`. 0.8 is not a new number -- anything below
# it is already flagged needs_review, so the audit runs on exactly the drafts a human would check.
DIAGRAM_EVAL_AUDIT_CONFIDENCE=0.8

# Second OCR pass on code regions to flag '_' vs '-' misreads for review (1=on, 0=off).
OCR_VERIFY_CODE=1

# --- Provider PRIVACY (student data) ---------------------------------------------------------
# ON BY DEFAULT in scripts/llm_client.py -- listed here so the policy is explicit in config.
# Two DIFFERENT guarantees, both needed:
#   data_collection=deny -> providers that will not TRAIN on the prompt
#   zdr=1                -> endpoints that do not STORE the prompt at rest
# OpenRouter's own default is data_collection="allow" (retention AND training permitted).
# Both RESTRICT the endpoint pool; verify your models still resolve:
#   python3 scripts/check_provider_privacy.py
LLM_PROVIDER_DATA_COLLECTION=deny
LLM_PROVIDER_ZDR=1

# Student identity extraction. HEADER_PROMPT is the only call whose PURPOSE is reading a child's
# Name / Class / Roll No off the sheet. It is skipped automatically whenever the teacher already
# supplied the name (the OCR'd one is discarded in that case anyway). Set to 0 to disable it for
# EVERY run -- appropriate when names come from a manifest or the filename. Default 1 keeps batch
# grading working, where the sheet's own header is how many scans get matched to pupils.
OCR_EXTRACT_STUDENT_PII=1

# Cascade escalation: does a PARTIAL-CREDIT mark alone justify a thinking-model re-grade?
# Default 0 (no). It used to fire on any 0 < mark < maximum, which after the grading calibration meant
# ~40% of answers -- so the cascade's cheap path stopped being the common path. Measured against a
# teacher's own per-question marks (22 LLM-graded questions, subtotal 48.5), through the real cascade:
#     narrowed (0):  total 47.0  MAE 0.43   2 escalations  19,038 output tokens
#     old      (1):  total 46.0  MAE 0.48  11 escalations  58,591 output tokens
# Escalating moved marks AWAY from the teacher, so this was not a speed-vs-accuracy trade -- the
# expensive path was also the less accurate one. Set to 1 to restore the old behaviour.
# Low confidence, off-topic, prompt injection, a non-finite mark and a substantive zero still escalate.
# Every escalation records `Escalated Because` on the result, so the trigger mix is readable off real runs.
EVAL_CASCADE_ESCALATE_PARTIAL=0

# Python bytecode caches
__pycache__/
*.pyc

# Test-runner cache
.pytest_cache/

# Evaluation output: scans, preprocessed pages, crops, OCR, per-run reports and ledgers. Large
# (~2.3 GB here) and REGENERATED by every run, so it does not belong in version control -- and it
# contains real student names and handwriting, which must not be pushed to a remote.
# NOTE: ~1,525 of these files were already committed before this rule existed; ignoring alone would
# not have untracked them, so they were removed from the index with `git rm -r --cached output/`.
# They remain in git HISTORY -- see docs/ARCHITECTURE-technical.md if that ever needs purging.
output/

# Uploaded source documents: student answer sheets, question papers and marking schemes. These are
# per-installation inputs (and student PII), not source -- 22 PDFs had reached 66 MB before this rule.
# The small current_*.json / *_state.json files in the same folder stay TRACKED on purpose: they are
# the app's live state (selected key, OR-choice sidecar, report path) and total under 0.3 MB.
evaluation_app/uploads/*.pdf
evaluation_app/uploads/*.docx

# macOS Finder metadata. Several of these had been COMMITTED before this rule existed, so
# `git rm --cached` is needed to untrack them; ignoring alone would not remove them from the index.
.DS_Store

# Secrets / local environment -- never commit API keys
.env
.env.*
!.env.example
# NOTE: .git/config (which holds the remote URL + any embedded token) lives inside the .git
# directory, which git NEVER tracks -- so it needs no ignore entry. Keep tokens out of the remote
# URL (use SSH or a credential helper) rather than relying on ignore rules.

# Answer-key parse cache (content-hashed; safe to delete)
.parse_cache/

# Report-collection worker state (ledger + log); the local archive lives OUTSIDE the repo
# (default ~/Evaluation Report Archive/) so it is not tracked. See docs/REPORT-SYNC.md.
.report_sync/

# Local/runtime files
uploads/
*.log
full_batch_log.txt

# macOS metadata
._*
.DS_Store

# Local Claude config
.claude/
